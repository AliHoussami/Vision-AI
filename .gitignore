# --- Python environment ---
.venv/
__pycache__/
*.py[cod]

# --- Model weights (auto-downloaded on first run, ~140MB) ---
# Ultralytics fetches these itself; committing them bloats the repo
# and they are not ours to redistribute.
*.pt

# --- Video in/out (~128MB here) ---
# Everything the pipeline reads or writes. Regenerate with run_demo.py
# or compare_trackers.py --record.
*.mp4
*.avi
*.mkv

# --- Event logs and analysis output ---
events.csv
webcam_events.csv
demo_events.csv

# --- Per-camera configuration ---
# zones.json holds pixel coordinates for ONE physical camera at ONE
# resolution. It is meaningless on anyone else's setup, so it stays
# local. zones.example.json is committed instead to document the shape.
zones.json

# --- Editor / OS noise ---
*.bak
.vscode/
.idea/
Thumbs.db
desktop.ini
