# --- Python environment ---
.venv/
__pycache__/
*.py[cod]

# --- Model weights (auto-downloaded on first run, ~140MB) ---
# Ultralytics fetches these itself; committing them bloats the repo
# and they are not ours to redistribute.
models/
*.pt

# --- Generated artifacts ---
# Everything the pipeline writes goes to output/: recordings, event logs,
# diagnostic clips. Regenerate with run_demo.py or compare_trackers.py.
output/

# Stray media / data left at the root by older runs
*.mp4
*.avi
*.mkv
*.csv
*.db
*.db-wal
*.db-shm
*.sqlite

# --- Per-camera / per-site configuration ---
# zones.json holds pixel coordinates for ONE physical camera at ONE
# resolution. It is meaningless on anyone else's setup, so it stays
# local. zones.example.json is committed instead to document the shape.
zones.json
config/zones/
# A real site config carries camera addresses; only the example is tracked.
config/site.yaml
config/*.local.yaml
# Camera credentials -- never commit these.
config/secrets.yaml
secrets.yaml

# --- Editor / OS noise ---
*.bak
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
